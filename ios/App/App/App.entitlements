<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SPEC-045 §4.2: Universal Links – QR-Codes und Login-Rücksprung öffnen die App.
	     Prüfung über https://bouldermate.ch/.well-known/apple-app-site-association -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bouldermate.ch</string>
		<string>applinks:www.bouldermate.ch</string>
	</array>
</dict>
</plist>
